ll expo(ll a, ll b, ll mod) {
   ll res = 1;
   while (b > 0){
     if (b & 1)res = (res * a) % mod;
      a = (a * a) % mod;
      b = b >> 1;
    }
    return res;
}
ll mminvprime(ll a, ll b) {
return expo(a, b - 2, b);
}


