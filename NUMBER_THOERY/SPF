const int N = 1000001; // maximum limit
vector<int> spf(N);     // spf[i] = smallest prime factor of i

// 🔹 Precompute SPF for all numbers up to N
void spf_sieve() {
    for (int i = 2; i < N; i++)
        spf[i] = i;

    for (int i = 2; i * i < N; i++) {
        if (spf[i] == i) { // i is prime
            for (int j = i * i; j < N; j += i) {
                if (spf[j] == j)
                    spf[j] = i;
            }
        }
    }
}

// 🔹 Return prime factorization of n using SPF in log(n)time
vector<int> spf_factor(int n) {
    vector<int> factors;
    while (n != 1) {
        factors.push_back(spf[n]);
        n /= spf[n];
    }
    return factors;
}
